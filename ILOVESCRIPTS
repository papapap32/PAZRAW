local function parseList(str)
  local t = {}
  if str == "" then return t end
  for w in str:gmatch("[^,%s]+") do table.insert(t, w:lower()) end
  return t
end

local function isTarget(n, targetList)
  if #targetList == 0 then return true end
  local ln = n:lower()
  for _, v in ipairs(targetList) do
    if ln:find(v, 1, true) then return true end
  end
  return false
end

local function isSafe(n, safeList)
  local ln = n:lower()
  for _, v in ipairs(safeList) do
    if ln:find(v, 1, true) then return true end
  end
  return false
end

local function isSafePlayer(plr)
  if not plr then return false end
  local whitelist = parseList(CONFIG.GlobalWhitelist)
  if #whitelist == 0 then return false end
  return isSafe(plr.Name, whitelist) or isSafe(plr.DisplayName, whitelist)
end

--═══════════════════════════════════════════════════════════════════
-- VOID / BRING LOGIC (sequential queue)
--═══════════════════════════════════════════════════════════════════
local VOID_STEP_DELAY  = 0.20
local BRING_STEP_DELAY = 0.11
local _queueRunning    = false

local function _startInstaReturn(savedCFrame, duration)
  local startTime = tick()
  local conn
  conn = runService.Heartbeat:Connect(function()
    if tick() - startTime > (duration or 0.8) then
      conn:Disconnect()
      return
    end
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
      pcall(function()
        hrp.CFrame = savedCFrame
        hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
      end)
    end
  end)
  return conn
end

local function performVoidOne(targetPlayer)
  if not targetPlayer or not targetPlayer.Character then return end
  local hrp0 = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
  if not hrp0 then return end
  local mySavedCFrame = hrp0.CFrame

  pcall(function()
    if CarryRequest then
      CarryRequest:FireServer(table.unpack({
        [1] = targetPlayer, [2] = CONFIG.InstaGymLength, [3] = CONFIG.InstaGymHeight,
        [4] = CONFIG.InstaGymDistance, [5] = 0, [6] = 0, [7] = 0,
      }))
    end
  end)
  task.wait(0.08)
  pcall(function() if EventTeleportEvent then EventTeleportEvent:FireServer() end end)
  task.wait(0.08)
  pcall(function() if StopCarry then StopCarry:FireServer() end end)

  local h = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
  if h then
    pcall(function()
      h.CFrame = mySavedCFrame
      h.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
    end)
  end
  local conn = _startInstaReturn(mySavedCFrame, 0.15)

  local waited = 0
  while waited < 0.25 do
    task.wait(0.03)
    waited = waited + 0.03
    local char = targetPlayer and targetPlayer.Character
    local th = char and char:FindFirstChild("HumanoidRootPart")
    if not th then break end
    if th.Position.Y < -100 or (th.Position - mySavedCFrame.Position).Magnitude > 500 then break end
  end
  if conn then conn:Disconnect() end
end

local function performBringOne(targetPlayer, customDestPos)
  if not targetPlayer or not targetPlayer.Character then return end
  local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
  if not hrp then return end

  local destPos = customDestPos or hrp.Position
  local mySpot = hrp.CFrame
  local argX = EVENT_X - destPos.X
  local argY = EVENT_Y - destPos.Y
  local argZ = EVENT_Z - destPos.Z

  pcall(function()
    if CarryRequest then
      CarryRequest:FireServer(table.unpack({
        [1] = targetPlayer, [2] = argX, [3] = argY, [4] = argZ, [5] = 0, [6] = 0, [7] = 0,
      }))
    end
  end)
  task.wait(0.05)
  pcall(function() if EventTeleportEvent then EventTeleportEvent:FireServer() end end)
  task.wait(0.05)
  pcall(function() if StopCarry then StopCarry:FireServer() end end)

  local startTime = tick()
  local conn
  conn = runService.Heartbeat:Connect(function()
    if tick() - startTime > 0.18 then
      conn:Disconnect()
      return
    end
    local h = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if h then
      pcall(function()
        h.CFrame = mySpot
        h.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
      end)
    end
  end)
  task.wait(0.18)
end

local function runSequentialQueue(playersList, actionName)
  if _queueRunning then
    warn("[Queue] Already running — try again in a moment")
    return
  end
  if #playersList == 0 then
    print("[Queue] No targets matched")
    return
  end
  _queueRunning = true
  task.spawn(function()
    for i, plr in ipairs(playersList) do
      if plr and plr.Character and plr ~= localPlayer then
        if actionName == "void" then
          performVoidOne(plr)
          task.wait(VOID_STEP_DELAY)
        else
          performBringOne(plr)
          task.wait(BRING_STEP_DELAY)
        end
      end
    end
    _queueRunning = false
  end)
end

local function collectTargets()
  local raw = CONFIG.BringTargetName
  if raw == nil or raw == "" then
    local out = {}
    for _, p in ipairs(players:GetPlayers()) do
      if p ~= localPlayer and not isSafePlayer(p) then
        table.insert(out, p)
      end
    end
    return out
  end

  local fragments = {}
  for w in raw:gmatch("[^,%s]+") do
    if #w > 0 then table.insert(fragments, w:lower()) end
  end
  if #fragments == 0 then
    local out = {}
    for _, p in ipairs(players:GetPlayers()) do
      if p ~= localPlayer and not isSafePlayer(p) then
        table.insert(out, p)
      end
    end
    return out
  end

  local out, seen = {}, {}
  for _, p in ipairs(players:GetPlayers()) do
    if p ~= localPlayer and not isSafePlayer(p) and not seen[p] then
      local pn = p.Name:lower()
      local dn = p.DisplayName:lower()
      for _, frag in ipairs(fragments) do
        if pn:find(frag, 1, true) or dn:find(frag, 1, true) then
          table.insert(out, p)
          seen[p] = true
          break
        end
      end
    end
  end
  return out
end

local function handleVoidButton()
  local targets = collectTargets()
  print("[Void] Queued " .. #targets .. " target(s)")
  runSequentialQueue(targets, "void")
end

local function handleBringButton()
  local targets = collectTargets()
  print("[Bring] Queued " .. #targets .. " target(s)")
  runSequentialQueue(targets, "bring")
end


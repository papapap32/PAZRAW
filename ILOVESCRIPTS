local BOT_CONFIG = {
    SelectedUser = nil,
    GiveCommandsEnabled = false,
    IsKilling = false,
    KillTarget = nil
}

local function onPlayerChatted(speakerName, message)
    if not BOT_CONFIG.GiveCommandsEnabled or not BOT_CONFIG.SelectedUser then return end
    
    if speakerName:lower() == BOT_CONFIG.SelectedUser.Name:lower() or speakerName:lower() == BOT_CONFIG.SelectedUser.DisplayName:lower() then
        if message:lower():sub(1, 5) == ".kill" then
            local targetName = message:sub(7):lower()
            local targetPlayer = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():find(targetName) or p.DisplayName:lower():find(targetName) then
                    targetPlayer = p
                    break
                end
            end
            
            if targetPlayer and targetPlayer ~= player then
                BOT_CONFIG.KillTarget = targetPlayer
                BOT_CONFIG.IsKilling = true
            end
        elseif message:lower() == ".stop" then
            BOT_CONFIG.IsKilling = false
            BOT_CONFIG.KillTarget = nil
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.Chatted:Connect(function(msg) onPlayerChatted(plr.Name, msg) end)
end)
for _, plr in ipairs(Players:GetPlayers()) do
    plr.Chatted:Connect(function(msg) onPlayerChatted(plr.Name, msg) end)
end

RunService.Heartbeat:Connect(function()
    if not BOT_CONFIG.IsKilling or not BOT_CONFIG.KillTarget then return end
    local myChar = player.Character
    local targetChar = BOT_CONFIG.KillTarget.Character
    
    if myChar and targetChar then
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        
        if myHRP and targetHRP and targetHum and targetHum.Health > 0 then
            myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
            if PunchDo then pcall(function() PunchDo:InvokeServer(targetHum) end) end
        else
            BOT_CONFIG.IsKilling = false
            BOT_CONFIG.KillTarget = nil
        end
    end
end)


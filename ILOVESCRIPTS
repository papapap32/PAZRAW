RunService.Heartbeat:Connect(function()
    if CONFIG.CombatBreakerEnabled and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum then
            local oldCF = hrp.CFrame
            local oldOffset = hum.CameraOffset
            
            local hideCF = oldCF * CFrame.new(0, -200000, 0)
            hrp.CFrame = hideCF
            hum.CameraOffset = hideCF:ToObjectSpace(CFrame.new(oldCF.Position)).Position
            
            RunService.RenderStepped:Wait()
            
            hrp.CFrame = oldCF
            hum.CameraOffset = oldOffset
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not CONFIG.FastEmoteEnabled or not player.Character then return end
    
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    
    if animator then
        if not CONFIG.FastEmoteTrack then preloadFastAnim() end
        
        if CONFIG.FastEmoteTrack then
            if not CONFIG.FastEmoteTrack.IsPlaying then
                CONFIG.FastEmoteTrack:Play()
            end
            
            local length = CONFIG.FastEmoteTrack.Length
            local timePos = CONFIG.FastEmoteTrack.TimePosition
            
            if timePos < 1 then
                CONFIG.FastEmoteTrack:AdjustSpeed(5) 
            elseif timePos > (length - 1) then
                CONFIG.FastEmoteTrack:AdjustSpeed(5)
            else
                CONFIG.FastEmoteTrack:AdjustSpeed(1)
            end
            
            if timePos >= (length - 0.05) then
                CONFIG.FastEmoteTrack.TimePosition = 0
            end
        end
    end
end)


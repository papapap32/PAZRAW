local function doLocalTeleport(character, attackerName)
    if not CONFIG.AntiHitEnabled or not character or CONFIG.Cooldown then return end
    local attacker = Players:FindFirstChild(attackerName)
    if not attacker or not attacker.Character or isSafePlayer(attacker) then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    CONFIG.Cooldown = true
    local originalCFrame = hrp.CFrame
    
    if StopCarry then pcall(function() StopCarry:FireServer() end) end
    if CarryRequest then pcall(function() CarryRequest:FireServer(attacker, 1, 0, 1, 0, 180, 0) end) end
    if AcceptRequest then
        for i = 1, 5 do
            pcall(function() AcceptRequest:FireServer(attacker) end)
            pcall(function() AcceptRequest:FireServer() end)
            task.wait(0.05)
        end
    end
    task.spawn(function()
        task.wait(0.1)
        if EventTeleportEvent then pcall(function() EventTeleportEvent:FireServer() end) end
    end)
    task.delay(2.0, function()
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hrp.Parent and hum and hum.Health > 0 then
            hrp.CFrame = originalCFrame
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if StopCarry then pcall(function() StopCarry:FireServer() end) end
        task.wait(0.5)
        CONFIG.Cooldown = false
    end)
end

local function doSkyDrop()
    if not CONFIG.SkyDropEnabled or not player.Character or CONFIG.SkyDropCooldown then return end
    CONFIG.SkyDropCooldown = true
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local originalPos = hrp.Position
    
    pcall(function()
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
        hrp.CFrame = CFrame.new(originalPos + Vector3.new(0, CONFIG.SkyHeight, 0))
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.delay(0.2, function()
            if hrp and hrp.Parent then
                hrp.CFrame = CFrame.new(originalPos)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            CONFIG.HitCount = 0
            task.wait(0.5)
            CONFIG.SkyDropCooldown = false
        end)
    end)
end

local function preloadFastAnim()
    if not player.Character then return end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    
    if animator then
        local anim = Instance.new("Animation")
        anim.AnimationId = CONFIG.FastEmoteID
        
        local success, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        
        if success then
            CONFIG.FastEmoteTrack = track
            CONFIG.FastEmoteTrack.Priority = Enum.AnimationPriority.Action4
        end
    end
end


local antiGrabCooldown = false

local EventSystem = replicatedStorage:FindFirstChild("EventInviteSystem")
local EventTeleportEvent = EventSystem and EventSystem:FindFirstChild("EventTeleportEvent")

local function setupAntiGrab(character)
  local hum = character:WaitForChild("Humanoid", 10)
  local hrp = character:WaitForChild("HumanoidRootPart", 10)
  if not hum or not hrp then return end

  hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
    if not antiGrabEnabled or antiGrabCooldown then return end
    if not hum.PlatformStand then return end

    antiGrabCooldown = true
    local savedPos = hrp.Position
    local savedCFrame = hrp.CFrame

    -- Fire event teleport to force server to reset grabbed state
    pcall(function()
      if EventTeleportEvent then
        EventTeleportEvent:FireServer()
      end
    end)

    -- After delay, snap back to saved position
    task.delay(antiGrabDelay, function()
      local currentHrp = localPlayer.Character
        and localPlayer.Character:FindFirstChild("HumanoidRootPart")
      if currentHrp then
        pcall(function()
          currentHrp.CFrame = savedCFrame
          currentHrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
          currentHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
      end
      antiGrabCooldown = false
    end)
  end)
end


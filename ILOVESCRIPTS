local function findMyPet()
    local char = player.Character
    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then return obj end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("pet") or obj:FindFirstChild("Humanoid")) then
            local owner = obj:FindFirstChild("Owner") or obj:FindFirstChild("Player")
            if owner and (owner.Value == player or owner.Value == player.Name or tostring(owner.Value) == player.Name) then
                return obj
            end
        end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if not CONFIG.PetSpamEnabled or not PetRenameRequest then return end
    local now = tick()
    local text = CONFIG.PetCustomText

    if not CONFIG.TargetPet or not CONFIG.TargetPet.Parent then
        if now - CONFIG.PetLastUpdate > 1 then CONFIG.TargetPet = findMyPet() end
    end

    if now - CONFIG.PetLastUpdate >= CONFIG.PetTypeSpeed then
        CONFIG.PetLastUpdate = now
        if CONFIG.PetCurrentIndex >= #text then
            CONFIG.PetCurrentIndex = 0
            CONFIG.PetLastSentName = ""
        end
        if CONFIG.PetCurrentIndex < #text then
            CONFIG.PetCurrentIndex = CONFIG.PetCurrentIndex + 1
            local displayText = string.sub(text, 1, CONFIG.PetCurrentIndex)
            if displayText ~= CONFIG.PetLastSentName then
                CONFIG.PetLastSentName = displayText
                task.spawn(function()
                    pcall(function()
                        if CONFIG.TargetPet then PetRenameRequest:FireServer(CONFIG.TargetPet, displayText) 
                        else PetRenameRequest:FireServer(displayText) end
                    end)
                end)
            end
        end
    end
end)


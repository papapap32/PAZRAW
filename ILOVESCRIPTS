RunService.Heartbeat:Connect(function()
    if not player.Character then return end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    
    if CONFIG.EmoteLock and CONFIG.SavedEmoteID ~= "" and animator then
        if not CONFIG.CurrentEmoteTrack or not CONFIG.CurrentEmoteTrack.IsPlaying then
            if CONFIG.CurrentEmoteTrack then CONFIG.CurrentEmoteTrack:Stop() end
            local anim = Instance.new("Animation")
            anim.AnimationId = CONFIG.SavedEmoteID
            CONFIG.CurrentEmoteTrack = animator:LoadAnimation(anim)
            CONFIG.CurrentEmoteTrack.Priority = Enum.AnimationPriority.Action4
            CONFIG.CurrentEmoteTrack.Looped = true
            CONFIG.CurrentEmoteTrack:Play()
        end
    elseif not CONFIG.EmoteLock and CONFIG.CurrentEmoteTrack then
        CONFIG.CurrentEmoteTrack:Stop()
        CONFIG.CurrentEmoteTrack = nil
    end

    if CONFIG.AutoAcceptCarry and CarryRequest then
        local acceptList = parseList(CONFIG.AutoAcceptWhitelist)
        local blacklist = parseList(CONFIG.AutoAcceptBlacklist)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                if not isSafe(p.Name, blacklist) and not isSafe(p.DisplayName, blacklist) then
                    local shouldSend = (#acceptList == 0) or isTarget(p.Name, acceptList) or isTarget(p.DisplayName, acceptList)
                    if shouldSend then
                        for i = 0, 1 do
                            pcall(function() CarryRequest:FireServer(p, 1, 0, 1, 0, 180, 0) end)
                        end
                    end
                end
            end
        end
    end
end)


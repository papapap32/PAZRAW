RunService.Heartbeat:Connect(function(dt)
    if not CONFIG.TpWalkEnabled or not player.Character then return end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    
    if hrp and hum then
        if not CONFIG.TpWalkAnim then preloadTpWalkAnim() end
        
        local moveDirection = hum.MoveDirection
        
        if moveDirection.Magnitude > 0 then
            local distance = CONFIG.TpWalkSpeed * dt
            hrp.CFrame = hrp.CFrame + (moveDirection * distance)
            
            hrp.AssemblyLinearVelocity = Vector3.Zero
            hrp.AssemblyAngularVelocity = Vector3.Zero
            
            if CONFIG.TpWalkAnim and not CONFIG.TpWalkAnim.IsPlaying then
                CONFIG.TpWalkAnim:Play()
            end
            
            if hum:GetState() ~= Enum.HumanoidStateType.Running then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        else
            if CONFIG.TpWalkAnim and CONFIG.TpWalkAnim.IsPlaying then
                CONFIG.TpWalkAnim:Stop()
            end
        end
    end
end)


local function setupCharacter(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        CONFIG.LastHealth = humanoid.Health
        
        humanoid.HealthChanged:Connect(function(newHealth)
            if newHealth < CONFIG.LastHealth and newHealth > 0 then
                local myHRP = character:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local closest, dist = nil, 30 
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and not isSafePlayer(plr) then
                            local d = (plr.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
                            if d < dist then dist = d; closest = plr.Name end
                        end
                    end
                    if closest then doLocalTeleport(character, closest) end
                end

                if CONFIG.AntiHit15Enabled and not CONFIG.AntiHit15Cooldown then
                    CONFIG.AntiHit15Cooldown = true
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local originalCFrame = hrp.CFrame
                        task.spawn(function()
                            pcall(function()
                                if EventTeleportEvent then EventTeleportEvent:FireServer() end
                                if ClassTeleportEvent then ClassTeleportEvent:FireServer() end
                                task.wait(1.5)
                                if StopCarry then StopCarry:FireServer() end
                                task.wait(0.1)
                                for i = 1, 5 do
                                    if hrp and hrp.Parent then
                                        hrp.CFrame = originalCFrame
                                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    end
                                    task.wait(0.05)
                                end
                                task.wait(0.5)
                                CONFIG.AntiHit15Cooldown = false
                            end)
                        end)
                    end
                end
            end
            
            if CONFIG.SkyDropEnabled and not CONFIG.SkyDropCooldown then
                if newHealth < CONFIG.LastHealth then
                    CONFIG.HitCount = CONFIG.HitCount + 1
                    if CONFIG.HitCount >= CONFIG.MaxHits then doSkyDrop() end
                end
            end
            CONFIG.LastHealth = newHealth
        end)

        humanoid.StateChanged:Connect(function(oldState, newState)
            if newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.FallingDown or newState == Enum.HumanoidStateType.PlatformStanding then
                
                if CONFIG.SkyDropEnabled and not CONFIG.SkyDropCooldown then
                    doSkyDrop()
                end
                
                if CONFIG.AntiGrabEnabled and not CONFIG.AntiGrabCooldown then
                    CONFIG.AntiGrabCooldown = true
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local originalCFrame = hrp.CFrame
                        task.spawn(function()
                            pcall(function()
                                if EventTeleportEvent then EventTeleportEvent:FireServer() end
                                if ClassTeleportEvent then ClassTeleportEvent:FireServer() end
                                task.wait(0.15)
                                if StopCarry then StopCarry:FireServer() end
                                task.wait(0.1)
                                for i = 1, 5 do
                                    if hrp and hrp.Parent then
                                        hrp.CFrame = originalCFrame
                                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    end
                                    task.wait(0.05)
                                end
                                task.wait(1.0)
                                CONFIG.AntiGrabCooldown = false
                            end)
                        end)
                    end
                end
            end
        end)
    end

    task.wait(0.5)
    preloadFastAnim()
    preloadTpWalkAnim()

    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if track.Priority == Enum.AnimationPriority.Action or track.Priority == Enum.AnimationPriority.Core then
                CONFIG.SavedEmoteID = track.Animation.AnimationId
            end
        end)
    end
    
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = CONFIG.JumpPower
    end
end


-- KILL AURA (15 STUD RANGE, SPHERE HITBOX 28)
task.spawn(function()
    while task.wait() do
        if CONFIG.KillAuraEnabled then
            local targetList = parseList(CONFIG.KillAuraTargetList)
            local safeList = parseList(CONFIG.KillAuraSafeList)
            
            local myChar = player.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local closestTarget = nil
            local closestDist = CONFIG.KillAuraRange -- 15
            
            -- 1. Find the closest player within 15 studs
            if myHRP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        
                        if hrp and hum and hum.Health > 0 then
                            local isWhitelisted = isSafe(p.Name, safeList) or isSafe(p.DisplayName, safeList)
                            local isInTargetList = isTarget(p.Name, targetList) or isTarget(p.DisplayName, targetList)
                            
                            if not isWhitelisted and isInTargetList then
                                local dist = (hrp.Position - myHRP.Position).Magnitude
                                if dist <= closestDist then
                                    closestDist = dist
                                    closestTarget = p
                                end
                            end
                        end
                    end
                end
            end
            
            -- 2. Apply SPHERE Hitbox to the closest player
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- Clean up old sphere mesh
                        local oldMesh = hrp:FindFirstChild("KillAuraSphere")
                        if oldMesh then oldMesh:Destroy() end
                        
                        if p == closestTarget then
                            -- Apply size 28 and make it a Sphere
                            hrp.Size = Vector3.new(CONFIG.KillAuraHitboxSize, CONFIG.KillAuraHitboxSize, CONFIG.KillAuraHitboxSize)
                            hrp.Transparency = CONFIG.KillAuraVisibility
                            hrp.BrickColor = BrickColor.new("Really red")
                            hrp.Material = Enum.Material.ForceField
                            hrp.CanCollide = false
                            
                            local sphere = Instance.new("SpecialMesh")
                            sphere.MeshType = Enum.MeshType.Sphere
                            sphere.Name = "KillAuraSphere"
                            sphere.Parent = hrp
                        else
                            hrp.Size = Vector3.new(2, 2, 1)
                            hrp.Transparency = 1
                        end
                    end
                end
            end
            
            -- 3. Click if we found a target within 15 studs
            if closestTarget then
                doClick()
                task.wait(kaClickInterval)
            else
                task.wait(0.1)
            end
        else
            task.wait(0.1)
        end
    end
end)

